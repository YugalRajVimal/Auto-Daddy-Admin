# Copy to .env and adjust for your environment
VITE_API_URL=https://app.autodaddy.ca
VITE_UPLOADS_URL=https://app.autodaddy.ca
# Stripe publishable key (pk_test_... or pk_live_...)
VITE_STRIPE_PUBLISHABLE_KEY=
# Optional — used in some user management views
# VITE_IMAGE_URL=https://app.autodaddy.ca

# Dev only (honored when Vite DEV=true). Force shop subscription gate:
#   true  → treat as subscribed (unlock shop features)
#   false → treat as not subscribed (lock features)
# Leave unset to use real API daysLeft > 0.
# VITE_DEV_SIMULATE_SUBSCRIPTION_ACTIVE=true
