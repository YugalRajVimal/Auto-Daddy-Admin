# Copy to .env and adjust for your environment
API_URL=https://autodaddyserver.devyugal.in
# Stripe publishable key (pk_test_... or pk_live_...)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Legacy Cashfree (only if resuming old pending orders)
EXPO_PUBLIC_CASHFREE_ENV=sandbox

# Dev only (honored when __DEV__=true). Force shop subscription gate:
#   true  → treat as subscribed (unlock shop features)
#   false → treat as not subscribed (lock features)
# Leave unset to use real API daysLeft > 0.
# EXPO_PUBLIC_DEV_SIMULATE_SUBSCRIPTION_ACTIVE=true

